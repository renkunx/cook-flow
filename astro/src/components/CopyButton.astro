---
interface Props {
  recipe: any;
  ingredients: any[];
}

const { recipe, ingredients } = Astro.props;

// 将数据序列化到 data 属性中
const recipeData = JSON.stringify(recipe);
const ingredientsData = JSON.stringify(ingredients);
---

<div id="copy-button-container" data-recipe={recipeData} data-ingredients={ingredientsData}>
  <button id="copy-btn" class="copy-button">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <span>复制到微信公众号</span>
  </button>
  <div id="copy-toast" class="copy-toast hidden">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>已复制！可直接粘贴到微信公众号</span>
  </div>
</div>

<script>
  const container = document.getElementById('copy-button-container');
  const copyBtn = document.getElementById('copy-btn');
  const toast = document.getElementById('copy-toast');

  const recipe = JSON.parse(container?.dataset.recipe || '{}');
  const ingredients = JSON.parse(container?.dataset.ingredients || '[]');

  function generateWechatHTML(recipe, ingredients) {
    const { name, description, image, nutrition, servings, steps } = recipe;

    // 营养信息
    let nutritionHTML = '';
    if (nutrition) {
      nutritionHTML = `
        <section style="padding: 20px; background: #FA5151; color: white; margin: 10px 0;">
          <h2 style="font-size: 18px; margin: 0 0 10px 0;">📊 营养信息</h2>
          <table style="width: 100%; border-collapse: collapse;">
            <tr>
              <td style="padding: 10px; background: rgba(255,255,255,0.2); text-align: center;">
                <div style="font-size: 14px; opacity: 0.8;">热量</div>
                <div style="font-size: 20px; font-weight: bold;">${nutrition.calories}</div>
                <div style="font-size: 12px; opacity: 0.7;">kcal</div>
              </td>
              <td style="padding: 10px; background: rgba(255,255,255,0.15); text-align: center;">
                <div style="font-size: 14px; opacity: 0.8;">蛋白质</div>
                <div style="font-size: 20px; font-weight: bold;">${nutrition.proteins}</div>
                <div style="font-size: 12px; opacity: 0.7;">g</div>
              </td>
            </tr>
            <tr>
              <td style="padding: 10px; background: rgba(255,255,255,0.15); text-align: center;">
                <div style="font-size: 14px; opacity: 0.8;">脂肪</div>
                <div style="font-size: 20px; font-weight: bold;">${nutrition.fats}</div>
                <div style="font-size: 12px; opacity: 0.7;">g</div>
              </td>
              <td style="padding: 10px; background: rgba(255,255,255,0.2); text-align: center;">
                <div style="font-size: 14px; opacity: 0.8;">碳水</div>
                <div style="font-size: 20px; font-weight: bold;">${nutrition.carbohydrates}</div>
                <div style="font-size: 12px; opacity: 0.7;">g</div>
              </td>
            </tr>
          </table>
        </section>
      `;
    }

    // 食材列表
    let ingredientsHTML = '';
    if (ingredients && ingredients.length > 0) {
      const ingredientRows = ingredients.map(ing => {
        const note = ing.note ? ` <span style="color: #888; font-size: 14px;">(${ing.note})</span>` : '';
        return `
          <tr style="border-bottom: 1px solid #E8E8E8;">
            <td style="padding: 12px 8px; color: #333;">${ing.food?.name || ''}${note}</td>
            <td style="padding: 12px 8px; text-align: right; color: #FA5151; font-weight: 600;">${ing.amount || ''} ${ing.unit?.name || ''}</td>
          </tr>
        `;
      }).join('');

      ingredientsHTML = `
        <section style="margin: 20px 0;">
          <h2 style="font-size: 18px; font-weight: bold; margin: 0 0 15px 0; color: #333;">🥗 食材清单<span style="font-size: 14px; color: #888; font-weight: normal; margin-left: 8px;">（${servings}人份）</span></h2>
          <table style="width: 100%; border-collapse: collapse; background: #F7F7F7; border-radius: 8px; overflow: hidden;">
            ${ingredientRows}
          </table>
        </section>
      `;
    }

    // 制作步骤
    const stepsHTML = (steps || []).map((step, index) => {
      const timeTag = step.time ? `<span style="display: inline-block; margin-top: 8px; padding: 4px 12px; background: #F0F0F0; border-radius: 4px; font-size: 13px; color: #666;">⏱ ${step.time} 分钟</span>` : '';
      return `
        <div style="margin: 20px 0; padding: 15px; background: white; border-left: 4px solid #FA5151; border-radius: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
          <div style="display: flex; align-items: center; margin-bottom: 10px;">
            <span style="display: inline-block; width: 24px; height: 24px; background: #FA5151; color: white; text-align: center; line-height: 24px; border-radius: 50%; font-weight: bold; margin-right: 10px;">${index + 1}</span>
            ${step.name ? `<span style="font-size: 16px; font-weight: bold; color: #333;">${step.name}</span>` : ''}
          </div>
          <div style="font-size: 15px; color: #555; line-height: 1.8; white-space: pre-wrap;">${step.instruction || ''}</div>
          ${timeTag}
        </div>
      `;
    }).join('');

    return `
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { margin: 0; padding: 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 677px; margin: 0 auto; }
  </style>
</head>
<body>
  <div class="container">
    <h1 style="font-size: 24px; font-weight: bold; text-align: center; margin: 0 0 15px 0; color: #333;">${name}</h1>
    ${description ? `<p style="font-size: 15px; color: #666; text-align: center; margin: 0 0 20px 0; line-height: 1.6;">${description}</p>` : ''}
    ${image ? `<img src="${image}" style="width: 100%; border-radius: 8px; margin: 0 0 20px 0;" alt="${name}">` : ''}
    ${nutritionHTML}
    ${ingredientsHTML}
    <section style="margin: 20px 0;">
      <h2 style="font-size: 18px; font-weight: bold; margin: 0 0 15px 0; color: #333;">👨‍🍳 制作步骤</h2>
      ${stepsHTML}
    </section>
    <div style="text-align: center; padding: 30px 0; margin-top: 40px; border-top: 1px solid #E8E8E8; color: #999; font-size: 13px;">
      — 本文由 私房小厨 提供 —
    </div>
  </div>
</body>
</html>
  `.trim();
  }

  async function copyToWechat(html) {
    try {
      const blob = new Blob([html], { type: 'text/html' });
      const clipboardItem = new ClipboardItem({ 'text/html': blob });
      await navigator.clipboard.write([clipboardItem]);
      return true;
    } catch (error) {
      console.error('Rich text copy failed:', error);
      try {
        const text = html.replace(/<[^>]+>/g, '').trim();
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }
  }

  copyBtn?.addEventListener('click', async () => {
    const html = generateWechatHTML(recipe, ingredients);
    const success = await copyToWechat(html);

    if (success) {
      toast?.classList.remove('hidden');
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>复制成功</span>
      `;

      setTimeout(() => {
        toast?.classList.add('hidden');
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 3000);
    } else {
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>复制失败</span>
      `;

      setTimeout(() => {
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 2000);
    }
  });
</script>

<style>
  #copy-button-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .copy-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    border: none;
    padding: 14px 24px;
    border-radius: 28px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
  }

  .copy-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4);
  }

  .copy-button:active {
    transform: translateY(0);
  }

  .copy-toast {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.15);
    font-size: 14px;
    color: #2D2D2D;
    border: 1px solid #FFE4D6;
    animation: slideIn 0.3s ease;
  }

  .copy-toast.hidden {
    display: none;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
