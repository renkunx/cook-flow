---
interface Props {
  recipe: any;
  ingredients: any[];
}

const { recipe, ingredients } = Astro.props;

// 将数据序列化到 data 属性中
const recipeData = JSON.stringify(recipe);
const ingredientsData = JSON.stringify(ingredients);
---

<div id="copy-button-container" data-recipe={recipeData} data-ingredients={ingredientsData}>
  <button id="copy-btn" class="copy-button">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <span>复制到微信公众号</span>
  </button>
  <div id="copy-toast" class="copy-toast hidden">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>已复制！可直接粘贴到微信公众号</span>
  </div>
</div>

<script>
  const container = document.getElementById('copy-button-container');
  const copyBtn = document.getElementById('copy-btn');
  const toast = document.getElementById('copy-toast');

  const recipe = JSON.parse(container?.dataset.recipe || '{}');
  const ingredients = JSON.parse(container?.dataset.ingredients || '[]');

  // 从 properties 中提取营养信息
  function getNutritionFromProperties(properties) {
    if (!properties || !Array.isArray(properties)) return null;

    const fieldMapping = {
      '热量': 'calories',
      '蛋白质': 'proteins',
      '脂肪': 'fats',
      '碳水化合物': 'carbohydrates',
      '卡路里': 'calories',
    };

    const nutrition = { calories: 0, proteins: 0, fats: 0, carbohydrates: 0 };

    properties.forEach(prop => {
      const name = prop.property_type?.name;
      if (name && fieldMapping[name]) {
        nutrition[fieldMapping[name]] = prop.property_amount || 0;
      }
    });

    // 检查是否有有效数据
    const hasData = Object.values(nutrition).some(v => v > 0);
    return hasData ? nutrition : null;
  }

  function generateWechatHTML(recipe, ingredients) {
    const { name, description, image, nutrition, servings, steps, properties } = recipe;

    // 获取有效的营养信息
    const effectiveNutrition = nutrition || getNutritionFromProperties(properties);

    // 营养信息
    let nutritionHTML = '';
    if (effectiveNutrition) {
      nutritionHTML = `
        <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background-color: #FF6B35;">
          <tr>
            <td colspan="4" style="padding: 12px 15px; color: white; font-size: 16px; font-weight: bold;">📊 营养信息</td>
          </tr>
          <tr>
            <td style="padding: 15px; text-align: center; color: white; width: 25%;">
              <div style="font-size: 13px;">热量</div>
              <div style="font-size: 20px; font-weight: bold; margin-top: 5px;">${effectiveNutrition.calories || 0}</div>
              <div style="font-size: 12px; margin-top: 3px;">kcal</div>
            </td>
            <td style="padding: 15px; text-align: center; color: white; width: 25%; background-color: #FF8C42;">
              <div style="font-size: 13px;">蛋白质</div>
              <div style="font-size: 20px; font-weight: bold; margin-top: 5px;">${effectiveNutrition.proteins || 0}</div>
              <div style="font-size: 12px; margin-top: 3px;">g</div>
            </td>
            <td style="padding: 15px; text-align: center; color: white; width: 25%; background-color: #FFAA5D;">
              <div style="font-size: 13px;">脂肪</div>
              <div style="font-size: 20px; font-weight: bold; margin-top: 5px;">${effectiveNutrition.fats || 0}</div>
              <div style="font-size: 12px; margin-top: 3px;">g</div>
            </td>
            <td style="padding: 15px; text-align: center; color: white; width: 25%; background-color: #FFC77B;">
              <div style="font-size: 13px;">碳水</div>
              <div style="font-size: 20px; font-weight: bold; margin-top: 5px;">${effectiveNutrition.carbohydrates || 0}</div>
              <div style="font-size: 12px; margin-top: 3px;">g</div>
            </td>
          </tr>
        </table>
      `;
    }

    // 食材列表
    let ingredientsHTML = '';
    if (ingredients && ingredients.length > 0) {
      const ingredientRows = ingredients.map(ing => {
        const note = ing.note ? ` <span style="color: #999; font-size: 13px;">（${ing.note}）</span>` : '';
        return `
          <tr>
            <td style="padding: 12px 15px; border-bottom: 1px solid #FFE4D6; color: #333; font-size: 15px;">${ing.food?.name || ''}${note}</td>
            <td style="padding: 12px 15px; border-bottom: 1px solid #FFE4D6; text-align: right; color: #FF6B35; font-weight: 600; font-size: 15px;">${ing.amount || ''} ${ing.unit?.name || ''}</td>
          </tr>
        `;
      }).join('');

      ingredientsHTML = `
        <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background-color: white; border-radius: 8px;">
          <tr>
            <td colspan="2" style="padding: 12px 15px; background-color: #FFE4D6; color: #FF6B35; font-size: 16px; font-weight: bold;">🥗 食材清单 <span style="font-size: 14px; font-weight: normal; color: #666;">（${servings}人份）</span></td>
          </tr>
          ${ingredientRows}
        </table>
      `;
    }

    // 制作步骤
    const stepsHTML = (steps || []).map((step, index) => {
      const timeTag = step.time ? `<div style="margin-top: 10px; padding: 6px 12px; background-color: #FFF0E6; color: #FF6B35; font-size: 13px; display: inline-block; border-radius: 4px;">⏱ ${step.time} 分钟</div>` : '';
      return `
        <table style="width: 100%; border-collapse: collapse; margin: 15px 0; background-color: white;">
          <tr>
            <td style="padding: 15px; border-left: 4px solid #FF6B35;">
              <table style="width: 100%; border-collapse: collapse;">
                <tr>
                  <td style="padding: 0; vertical-align: top; width: 30px;">
                    <span style="display: inline-block; width: 26px; height: 26px; background-color: #FF6B35; color: white; text-align: center; line-height: 26px; border-radius: 50%; font-weight: bold; font-size: 14px;">${index + 1}</span>
                  </td>
                  <td style="padding: 0 0 0 12px; vertical-align: top;">
                    ${step.name ? `<div style="font-size: 16px; font-weight: bold; color: #333; margin-bottom: 8px;">${step.name}</div>` : ''}
                    <div style="font-size: 15px; color: #555; line-height: 1.8; white-space: pre-wrap;">${step.instruction || ''}</div>
                    ${timeTag}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      `;
    }).join('');

    return `
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background-color: #FFF5F0;">
  <div style="max-width: 677px; margin: 0 auto; padding: 20px; background-color: #FFF5F0;">
    <h1 style="font-size: 24px; font-weight: bold; text-align: center; margin: 0 0 15px 0; color: #FF6B35;">${name}</h1>
    ${description ? `<p style="font-size: 15px; color: #666; text-align: center; margin: 0 0 20px 0; line-height: 1.6;">${description}</p>` : ''}
    ${image ? `<img src="${image}" style="width: 100%; border-radius: 8px; margin: 0 0 20px 0; display: block;" alt="${name}">` : ''}
    ${nutritionHTML}
    ${ingredientsHTML}
    <div style="margin: 20px 0;">
      <h2 style="font-size: 18px; font-weight: bold; margin: 0 0 15px 0; color: #333;">👨‍🍳 制作步骤</h2>
      ${stepsHTML}
    </div>
    <div style="text-align: center; padding: 30px 0; margin-top: 40px; border-top: 1px solid #E8E8E8; color: #999; font-size: 13px;">
      — 本文由 私房小厨 提供 —
    </div>
  </div>
</body>
</html>
  `.trim();
  }

  async function copyToWechat(html) {
    try {
      const blob = new Blob([html], { type: 'text/html' });
      const clipboardItem = new ClipboardItem({ 'text/html': blob });
      await navigator.clipboard.write([clipboardItem]);
      return true;
    } catch (error) {
      console.error('Rich text copy failed:', error);
      try {
        const text = html.replace(/<[^>]+>/g, '').trim();
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }
  }

  copyBtn?.addEventListener('click', async () => {
    const html = generateWechatHTML(recipe, ingredients);
    const success = await copyToWechat(html);

    if (success) {
      toast?.classList.remove('hidden');
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>复制成功</span>
      `;

      setTimeout(() => {
        toast?.classList.add('hidden');
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 3000);
    } else {
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>复制失败</span>
      `;

      setTimeout(() => {
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 2000);
    }
  });
</script>

<style>
  #copy-button-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .copy-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    border: none;
    padding: 14px 24px;
    border-radius: 28px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
  }

  .copy-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4);
  }

  .copy-button:active {
    transform: translateY(0);
  }

  .copy-toast {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.15);
    font-size: 14px;
    color: #2D2D2D;
    border: 1px solid #FFE4D6;
    animation: slideIn 0.3s ease;
  }

  .copy-toast.hidden {
    display: none;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
