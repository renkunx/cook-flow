---
interface Props {
  recipe: any;
  ingredients: any[];
}

const { recipe, ingredients } = Astro.props;

// 将数据序列化到 data 属性中
const recipeData = JSON.stringify(recipe);
const ingredientsData = JSON.stringify(ingredients);
---

<div id="copy-button-container" data-recipe={recipeData} data-ingredients={ingredientsData}>
  <button id="copy-btn" class="copy-button">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <span>复制到微信公众号</span>
  </button>
  <div id="copy-toast" class="copy-toast hidden">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>已复制！可直接粘贴到微信公众号</span>
  </div>
</div>

<script>
  const container = document.getElementById('copy-button-container');
  const copyBtn = document.getElementById('copy-btn');
  const toast = document.getElementById('copy-toast');

  const recipe = JSON.parse(container?.dataset.recipe || '{}');
  const ingredients = JSON.parse(container?.dataset.ingredients || '[]');

  function generateWechatHTML(recipe, ingredients) {
    const { name, description, image, nutrition, servings, steps } = recipe;

    const nutritionHTML = nutrition
      ? `
      <div style="margin-bottom: 24px;">
        <div style="font-size: 18px; font-weight: 600; margin-bottom: 12px; color: #333;">📊 营养信息</div>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
          <div style="padding: 14px; border-radius: 8px; text-align: center; background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);">
            <div style="font-size: 13px; color: #666; margin-bottom: 6px;">热量</div>
            <div style="font-size: 22px; font-weight: 700; color: #EA580C; margin-bottom: 2px;">${nutrition.calories}</div>
            <div style="font-size: 12px; color: #999;">kcal</div>
          </div>
          <div style="padding: 14px; border-radius: 8px; text-align: center; background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);">
            <div style="font-size: 13px; color: #666; margin-bottom: 6px;">蛋白质</div>
            <div style="font-size: 22px; font-weight: 700; color: #D97706; margin-bottom: 2px;">${nutrition.proteins}</div>
            <div style="font-size: 12px; color: #999;">g</div>
          </div>
          <div style="padding: 14px; border-radius: 8px; text-align: center; background: linear-gradient(135deg, #FEFCE8 0%, #FEF9C3 100%);">
            <div style="font-size: 13px; color: #666; margin-bottom: 6px;">脂肪</div>
            <div style="font-size: 22px; font-weight: 700; color: #CA8A04; margin-bottom: 2px;">${nutrition.fats}</div>
            <div style="font-size: 12px; color: #999;">g</div>
          </div>
          <div style="padding: 14px; border-radius: 8px; text-align: center; background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);">
            <div style="font-size: 13px; color: #666; margin-bottom: 6px;">碳水</div>
            <div style="font-size: 22px; font-weight: 700; color: #DC2626; margin-bottom: 2px;">${nutrition.carbohydrates}</div>
            <div style="font-size: 12px; color: #999;">g</div>
          </div>
        </div>
      </div>
    `
      : '';

    const ingredientsHTML = ingredients.length
      ? `
      <div style="margin-bottom: 24px;">
        <div style="font-size: 18px; font-weight: 600; margin-bottom: 12px; color: #333;">🥗 食材清单<span style="font-size: 14px; color: #999; font-weight: 400; margin-left: 4px;">（${servings}人份）</span></div>
        <div style="background: #F7F7F7; border-radius: 8px; padding: 12px 16px;">
          ${ingredients.map(ing => `
            <div style="display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #E8E8E8; font-size: 15px;">
              <span style="flex: 1; color: #333;">${ing.food?.name || ''}</span>
              <span style="color: #FF6B35; font-weight: 500; margin-left: 12px;">${ing.amount || ''} ${ing.unit?.name || ''}</span>
              ${ing.note ? `<span style="color: #999; font-size: 14px; margin-left: 8px;">(${ing.note})</span>` : ''}
            </div>
          `).join('')}
        </div>
      </div>
    `
      : '';

    const stepsHTML = steps
      .map((step, index) => `
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <div style="flex-shrink: 0; width: 28px; height: 28px; background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%); color: white; text-align: center; line-height: 28px; border-radius: 50%; font-size: 14px; font-weight: 600;">${index + 1}</div>
          <div style="flex: 1;">
            ${step.name ? `<div style="font-size: 16px; font-weight: 600; color: #333; margin-bottom: 6px;">${step.name}</div>` : ''}
            <div style="font-size: 15px; color: #555; line-height: 1.75; white-space: pre-wrap;">${step.instruction || ''}</div>
            ${step.time ? `<div style="font-size: 13px; color: #999; margin-top: 8px;">⏱ ${step.time} 分钟</div>` : ''}
          </div>
        </div>
      `)
      .join('');

    return `
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.75; color: #333; background: #fff; padding: 20px; }
  </style>
</head>
<body>
  <div style="max-width: 677px; margin: 0 auto;">
    <h1 style="font-size: 24px; font-weight: 600; text-align: center; margin-bottom: 12px;">${name}</h1>
    ${description ? `<p style="font-size: 15px; color: #666; text-align: center; margin-bottom: 16px;">${description}</p>` : ''}
    ${image ? `<img src="${image}" style="width: 100%; border-radius: 8px; margin-bottom: 20px;">` : ''}
    ${nutritionHTML}
    ${ingredientsHTML}
    <div style="margin-bottom: 24px;">
      <div style="font-size: 18px; font-weight: 600; margin-bottom: 12px; color: #333;">👨‍🍳 制作步骤</div>
      ${stepsHTML}
    </div>
    <div style="text-align: center; padding: 24px 0; color: #999; font-size: 13px; border-top: 1px solid #E8E8E8; margin-top: 32px;">
      — 本文由 私房小厨 提供 —
    </div>
  </div>
</body>
</html>
  `.trim();
  }

  async function copyToWechat(html) {
    try {
      const blob = new Blob([html], { type: 'text/html' });
      const clipboardItem = new ClipboardItem({ 'text/html': blob });
      await navigator.clipboard.write([clipboardItem]);
      return true;
    } catch (error) {
      try {
        const text = html.replace(/<[^>]+>/g, '').trim();
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }
  }

  copyBtn?.addEventListener('click', async () => {
    const html = generateWechatHTML(recipe, ingredients);
    const success = await copyToWechat(html);

    if (success) {
      toast?.classList.remove('hidden');
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>复制成功</span>
      `;

      setTimeout(() => {
        toast?.classList.add('hidden');
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 3000);
    } else {
      copyBtn.innerHTML = `
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>复制失败</span>
      `;

      setTimeout(() => {
        copyBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>复制到微信公众号</span>
        `;
      }, 2000);
    }
  });
</script>

<style>
  #copy-button-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
  }

  .copy-button {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    border: none;
    padding: 14px 24px;
    border-radius: 28px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
    transition: all 0.3s ease;
  }

  .copy-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 107, 53, 0.4);
  }

  .copy-button:active {
    transform: translateY(0);
  }

  .copy-toast {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    padding: 12px 20px;
    border-radius: 12px;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.15);
    font-size: 14px;
    color: #2D2D2D;
    border: 1px solid #FFE4D6;
    animation: slideIn 0.3s ease;
  }

  .copy-toast.hidden {
    display: none;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
