---
import type { Step } from '../utils/api';

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<section class="step-section">
  <div class="section-header">
    <div class="section-icon">👨‍🍳</div>
    <h2 class="section-title">制作步骤</h2>
  </div>

  <div class="steps-container">
    {steps.map((step, index) => (
      <div class="step-item">
        <div class="step-number">{index + 1}</div>
        <div class="step-content">
          {step.name && (
            <h3 class="step-name">{step.name}</h3>
          )}
          <p class="step-text">{step.instruction || ''}</p>
          {step.time && (
            <div class="step-time">
              <svg class="time-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{step.time} 分钟</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .step-section {
    margin-bottom: 2rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .section-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #FF6B35;
    margin: 0;
  }

  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step-item {
    display: flex;
    gap: 1rem;
  }

  .step-number {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1rem;
    font-weight: 700;
    box-shadow: 0 2px 4px rgba(255, 107, 53, 0.3);
  }

  .step-content {
    flex: 1;
    padding-top: 0.25rem;
  }

  .step-name {
    font-size: 1rem;
    font-weight: 600;
    color: #2D2D2D;
    margin: 0 0 0.5rem 0;
  }

  .step-text {
    font-size: 0.9375rem;
    color: #555555;
    line-height: 1.75;
    margin: 0;
    white-space: pre-wrap;
  }

  .step-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    padding: 0.375rem 0.75rem;
    background: linear-gradient(135deg, #FFF0E6 0%, #FFF8F3 100%);
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    color: #666666;
    font-weight: 500;
    border: 1px solid #FFE4D6;
  }

  .time-icon {
    width: 0.875rem;
    height: 0.875rem;
    color: #FF6B35;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 1.5rem;
    }

    .steps-container {
      gap: 2rem;
    }

    .step-number {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.125rem;
    }

    .step-name {
      font-size: 1.125rem;
    }

    .step-text {
      font-size: 1rem;
    }
  }
</style>
