---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title = '私房小厨 - 美味家常菜谱',
  description = '承包你的一日三餐与四季风味',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo">
          <img src="/logo.png" alt="私房小厨" class="logo-image" />
        </a>
        <nav class="site-nav">
          <a href="/" class="nav-link active">菜谱列表</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; {new Date().getFullYear()} 私房小厨. 用心做好每一道菜.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --primary-gradient: linear-gradient(135deg, #FF6B35 0%, #FF8C42 50%, #FFB347 100%);
    --primary-color: #FF6B35;
    --primary-dark: #E85A2B;
    --secondary-color: #FF8C42;
    --accent-color: #FFB347;
    --text-primary: #2D2D2D;
    --text-secondary: #666666;
    --text-light: #999999;
    --bg-primary: #FFFFFF;
    --bg-secondary: #FFF8F3;
    --bg-tertiary: #FFF0E6;
    --border-color: #FFE4D6;
    --shadow-sm: 0 1px 2px 0 rgba(255, 107, 53, 0.05);
    --shadow-md: 0 4px 6px -1px rgba(255, 107, 53, 0.1), 0 2px 4px -1px rgba(255, 107, 53, 0.06);
    --shadow-lg: 0 10px 15px -3px rgba(255, 107, 53, 0.1), 0 4px 6px -2px rgba(255, 107, 53, 0.05);
  }

  body {
    background: #FFFBF8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    background: var(--primary-gradient);
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .logo-image {
    height: 2.5rem;
    width: auto;
    display: block;
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.2);
  }

  .nav-icon {
    width: 1rem;
    height: 1rem;
    margin-right: 0.25rem;
    display: inline-block;
    vertical-align: middle;
  }

  .site-main {
    flex: 1;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  .site-footer {
    background: white;
    border-top: 3px solid #FFE4D6;
    margin-top: auto;
  }

  .footer-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1rem;
    text-align: center;
  }

  .footer-container p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (min-width: 640px) {
    .site-main {
      padding: 2rem 1rem;
    }
  }
</style>
