---
import Layout from '../layouts/Layout.astro';
import { getRecipes, type RecipeListItem } from '../utils/api';
import HomePage from '../components/HomePage.vue';

export const prerender = false;

// 初始加载第一页
let initialRecipes: RecipeListItem[] = [];
let totalCount = 0;
let error = null;

try {
  const response = await getRecipes(1, 20);
  initialRecipes = response.results;
  totalCount = response.count;
  console.log('Server-side data loaded:', { initialRecipes: initialRecipes.length, totalCount });
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load recipes';
  console.error('Server-side error:', e);
}

// 获取 API 配置
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
const API_TOKEN = import.meta.env.PUBLIC_API_TOKEN || '';
console.log('API config:', { API_URL, hasToken: !!API_TOKEN });
---

<script define:vars={{ initialRecipes, totalCount, API_URL, API_TOKEN }}>
  // 将服务端数据传递给全局变量，供 Vue 组件使用
  window.__INITIAL_DATA__ = {
    initialRecipes: initialRecipes,
    totalCount: totalCount,
    apiUrl: API_URL,
    apiToken: API_TOKEN
  };
  console.log('Global data set:', window.__INITIAL_DATA__);
</script>

<Layout title="私房小厨 - 美味家常菜谱">
  {error ? (
    <div class="error-banner">
      <svg class="error-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <p class="error-title">加载失败</p>
        <p class="error-message">{error}</p>
      </div>
    </div>
  ) : (
    <HomePage
      client:load
      :api-url={API_URL}
      :api-token={API_TOKEN}
    />
  )}
</Layout>

<style>
  .error-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: #FEF2F2;
    border: 1px solid #FEE2E2;
    border-radius: 0.75rem;
    color: #991B1B;
  }

  .error-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .error-title {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .error-message {
    font-size: 0.875rem;
  }
</style>
