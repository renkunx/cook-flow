---
import FreshPlateLayout from '../../layouts/FreshPlateLayout.astro';
import { getRecipe, extractIngredients, formatTime } from '../../utils/api';
import RecipeDetailPage from '../../components/RecipeDetailPage.vue';

export const prerender = false;

// 获取菜谱 ID
const { id } = Astro.params;

let recipe = null;
let error = null;
let notFound = false;

try {
  const numericId = parseInt(id, 10);
  if (isNaN(numericId)) {
    notFound = true;
  } else {
    recipe = await getRecipe(id);
    console.log('Recipe loaded:', recipe?.name);
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load recipe';
  console.error('Recipe loading error:', e);
  notFound = true;
}

// 404 页面
if (notFound || !recipe) {
  return Astro.redirect('/404');
}

// 获取 API 配置
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';
const API_TOKEN = import.meta.env.PUBLIC_API_TOKEN || '';

// 从步骤中提取食材
const ingredients = extractIngredients(recipe.steps || []);

// 获取相关菜谱（这里简化处理，实际可以调用 API 获取相关推荐）
---

<script define:vars={{ recipe, ingredients, API_URL, API_TOKEN }}>
  window.__RECIPE_DATA__ = {
    recipe,
    ingredients,
    apiUrl: API_URL,
    apiToken: API_TOKEN
  };
</script>

<FreshPlateLayout title={`${recipe.name} - 私房小厨`}>
  <RecipeDetailPage
    client:load
    :recipe="recipe"
    :ingredients="ingredients"
  />
</FreshPlateLayout>
